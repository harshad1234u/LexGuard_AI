# ---------------------------------------------------------------------------
# PromptWars Legal AI - backend environment
# Copy to backend/.env and fill in real values. NEVER commit the real .env.
# The NVIDIA key is server-side only and must never reach the browser.
# ---------------------------------------------------------------------------

# --- Model provider (NVIDIA Build / NIM hosted API) ---
NVIDIA_API_KEY=nvapi-replace-with-your-own-key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
MODEL_TEMPERATURE=0.6
MODEL_TOP_P=0.95
MODEL_MAX_OUTPUT_TOKENS=20480
MODEL_TIMEOUT_SECONDS=180

# --- Workflow ---
# Whole-run budget for one analysis, above the provider's per-call timeout.
ANALYSIS_TIMEOUT_SECONDS=900
# Budget for one synchronous Q&A request. Shorter: a person is waiting.
QA_TIMEOUT_SECONDS=120

# --- Upload limits (FR-01 file validation) ---
MAX_UPLOAD_BYTES=26214400
MAX_PAGES=300
# Cap on a JSON request body, checked before it is parsed.
MAX_JSON_BODY_BYTES=65536

# --- Ephemeral processing (ADR-005: no permanent document storage) ---
TEMP_WORKSPACE_DIR=
DOCUMENT_TTL_SECONDS=3600

# --- API ---
ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
