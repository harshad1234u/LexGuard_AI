# ---------------------------------------------------------------------------
# LexGuard AI - backend environment (canonical; Phase 23)
# Copy to backend/.env and fill in real values. NEVER commit the real .env.
# Every key below is server-side only and must never reach the browser.
# ---------------------------------------------------------------------------

# --- Provider roles -----------------------------------------------------------
# Validated at startup: an unknown value refuses to start. There is NO fallback:
# each role only ever calls the provider named here. A role whose key is
# missing reports "not configured" (HTTP 503) rather than using another vendor.
ANALYSIS_PROVIDER=gemini          # gemini | nemotron
QA_PROVIDER=gemini                # gemini | nemotron
REASONING_PROVIDER=nemotron       # nemotron | none
# Master switch. Reasoning runs only if this is true AND REASONING_PROVIDER is
# not "none"; either one saying off wins.
REASONING_ENABLED=true

# --- Gemini (Google AI Studio key) -------------------------------------------
GEMINI_API_KEY=
# Required whenever ANALYSIS_PROVIDER or QA_PROVIDER is gemini - the app will
# not start without it. Check the current model list before changing it:
# https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.8-flash

# --- NVIDIA (NVIDIA Build / NIM hosted API) ----------------------------------
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b

# --- Model call parameters (shared) ------------------------------------------
MODEL_TEMPERATURE=0.6
MODEL_TOP_P=0.95
MODEL_MAX_OUTPUT_TOKENS=20480
# Per analysis / Q&A provider call.
MODEL_TIMEOUT_SECONDS=420
# Per reasoning call. Also capped by what is left of ANALYSIS_TIMEOUT_SECONDS.
REASONING_TIMEOUT_SECONDS=90

# --- Workflow -----------------------------------------------------------------
# Whole-run budget for one analysis, above the provider's per-call timeout.
ANALYSIS_TIMEOUT_SECONDS=900
# Budget for one synchronous Q&A request. Shorter: a person is waiting.
QA_TIMEOUT_SECONDS=120

# --- Upload limits ------------------------------------------------------------
MAX_UPLOAD_BYTES=26214400
MAX_PAGES=300
# Cap on a JSON request body, checked before it is parsed.
MAX_JSON_BODY_BYTES=65536

# --- Ephemeral processing (ADR-005: documents are never stored permanently) ---
TEMP_WORKSPACE_DIR=
DOCUMENT_TTL_SECONDS=3600

# --- API ----------------------------------------------------------------------
# Comma-separated. In production, the exact Vercel origin(s), e.g.
# https://lexguard.vercel.app
ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
APP_ENV=development               # development | production

# --- Optional metadata persistence (Supabase; backend only) ------------------
# Leave SUPABASE_URL empty to keep everything in memory (the default).
# Stores metadata and RELEASED findings only - never PDFs, page text, raw
# filenames, questions, answers or withheld output. Requires the migration in
# supabase/migrations/ to have been applied; otherwise writes are refused.
SUPABASE_URL=
# Service-role key: bypasses RLS. Backend only. Never in the frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Salt for the stored filename hash. Required when APP_ENV=production.
PERSISTENCE_HASH_SALT=
SUPABASE_RETENTION_DAYS=30
