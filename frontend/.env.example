# Frontend build-time configuration. Everything here is PUBLIC: Vite inlines
# VITE_* values into the JavaScript bundle that every visitor downloads.
# Never put an API key, a Supabase key or any other secret in this file.

# Origin of the FastAPI backend, without a trailing slash. Leave empty in
# development (the Vite dev server proxies /api to localhost:8000).
# In Vercel: set it in Project Settings -> Environment Variables, e.g.
#   VITE_API_BASE_URL=https://lexguard-api.onrender.com
VITE_API_BASE_URL=
